  spinCount-=superSpinUpgradeCost;
  superSpinChance+=5;
  if(superSpinChance>100){
    let idiot=achievements.find(a=>a.id==="idiot");
    if(idiot && !idiot.unlocked)unlockAchievement(idiot);
  }
  superSpinUpgradeCost=Math.ceil(superSpinUpgradeCost*(1.5*rebirthScalingFactor));
  if(superSpinUpgradeCost>COST_CAP)superSpinUpgradeCost=COST_CAP;
  document.getElementById("superSpinCost").textContent="SUPER SPIN upgrade cost: "+superSpinUpgradeCost+" spins";
  document.getElementById("superSpinChance").textContent="SUPER SPIN chance: "+superSpinChance+"%";
  document.getElementById("counter").textContent="Times box spun: "+spinCount;
  addLog("SUPER SPIN chance is now "+superSpinChance+"%.","system");
  checkAchievements(0,false,false);
}
function upgradeSuperMult(){
