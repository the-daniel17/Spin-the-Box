function cheat(input){
  if(!input.startsWith("\\"))return;

  if(input.startsWith("\\enter[")){
    let inside=input.slice(7,-1);
    let [key,value]=inside.split("=");
    if(key==="devmode"){
      if(value==="true"){
        devmodeEnabled=true;
        devmodeEver=true;
        cheatUsed=false;
        updateCheatUI();
        updateCheatWarning();
        addLog("Devmode enabled (secret, no restrictions).","dev");
        let a=achievements.find(x=>x.id==="knowDev");
        if(a && !a.unlocked)unlockAchievement(a);
      }else if(value==="false"){
        devmodeEnabled=false;
        updateCheatUI();
        updateCheatWarning();
        addLog("Devmode disabled.","dev");
      }
    }
    return;
  }

  if(!cheaterMode && !devmodeEnabled){
    alert("Cheats are disabled.");
    addLog("Cheat attempt blocked (no mode active).","error");
    return;
  }

  const isDev=devmodeEnabled;
  if(!isDev){cheatUsed=true;updateCheatWarning();}

  if(input.startsWith("\\unlock[")){
    if(!isDev){
      alert("Achievement unlock cheats are devmode-only.");
      addLog("Blocked attempt to unlock achievement via cheat (non-dev).","error");
      return;
    }
    let inside=input.slice(8,-1);
    let [key,value]=inside.split("=");
    if(key==="achievement"){
      let a=achievements.find(x=>x.id===value);
      if(a)unlockAchievement(a),addLog("Dev: unlocked achievement "+value+".","dev");
      else addLog("Dev: tried to unlock unknown achievement "+value+".","error");
    }
    return;
  }

  if(input.startsWith("\\achievements[")){
    let inside=input.slice(13,-1);
    let [key,value]=inside.split("=");
    if(key==="give" && value==="all"){
      if(!isDev){
        alert("Giving all achievements at once is devmode-only.");
        addLog("Blocked attempt to give all achievements (non-dev).","error");
        return;
      }
      achievements.forEach(a=>unlockAchievement(a));
      addLog("Dev: gave all achievements.","dev");
      return;
    }
  }

  if(input.startsWith("\\show[")){
    let inside=input.slice(6,-1);
    if(inside==="spins"){
      addLog("Spins: "+spinCount+" | Lifetime: "+lifetimeSpins,"system");
    }else if(inside==="stats"){
      addLog("Stats -> Spins: "+spinCount+", Lifetime: "+lifetimeSpins+
             ", Prestiges: "+prestiges+", Rebirths: "+rebirths+
             ", PTM: x"+(currentPTM()*globalMult()).toFixed(2)+
             ", SuperChance: "+superSpinChance+"%, SuperMult: x"+superMult.toFixed(1),"system");
    }else if(inside==="prestiges"){
      addLog("Prestiges: "+prestiges+" (Next cost: "+prestigeCost+")","system");
    }else if(inside==="multiplier"){
      addLog("SUPER Multiplier: x"+superMult.toFixed(1),"system");
    }else if(inside==="rebirths"){
      addLog("Rebirths: "+rebirths+" (Next cost: "+rebirthCost()+" CC)","system");
    }else if(inside==="cosmic_coins"){
      addLog("Cosmic Coins: "+cosmicCoins,"system");
    }else if(inside==="rebirth_points"){
      addLog("Rebirth Points: "+rebirthPoints,"system");
    }
    return;
  }

  if(input.startsWith("\\force[")){
    let inside=input.slice(7,-1);
    let [key,value]=inside.split("=");
    if(key==="prestige"){
      if(!value){
        addLog("Invalid input: (empty) (expected whole number ≥ 1)","error");
        return;
      }
      let n=Number(value);
      if(!Number.isInteger(n) || n<1){
        addLog("Invalid input: "+value+" (expected whole number ≥ 1)","error");
        return;
      }
      for(let i=0;i<n;i++){
        prestiges++;
        prestigeCost+=50000;
      }
      recalcCostCap();
      document.getElementById("prestigeCount").textContent="Prestiges: "+prestiges;
      document.getElementById("prestigeCost").textContent="Prestige cost: "+prestigeCost.toLocaleString();
      updatePTMDisplay();
      addLog("Forced "+n+" prestiges (now at "+prestiges+" total)","dev");
    }
    if(key==="rebirths"){
      if(!value){
        addLog("Invalid input: (empty) (expected whole number ≥ 1)","error");
        return;
      }
      let n=Number(value);
      if(!Number.isInteger(n) || n<1){
        addLog("Invalid input: "+value+" (expected whole number ≥ 1)","error");
        return;
      }
      for(let i=0;i<n;i++){
        rebirths++;
        let gainedRP=rebirths*10;
        rebirthPoints+=gainedRP;
        rebirthScalingFactor*=0.90;
        if(rebirthScalingFactor<1.005)rebirthScalingFactor=1.005;
      }
      recalcCostCap();
      resetEverythingForRebirth();
      updateCosmicRebirthUI();
      updatePTMDisplay();
      addLog("Forced "+n+" rebirths (now at "+rebirths+" total)","dev");
    }
    return;
  }

  if(input.startsWith("\\set[")){
    let inside=input.slice(5,-1);
    let [key,value]=inside.split("=");
    if(key==="spins"){
      let newValue=Number(value);
      lifetimeSpins+=Math.max(0,newValue-spinCount);
      spinCount=newValue;
      document.getElementById("counter").textContent="Times box spun: "+spinCount;
      document.getElementById("lifetime").textContent="Lifetime box spun: "+lifetimeSpins;
      addLog("Cheat: set spins to "+newValue+".",isDev?"dev":"cheat");
    }
    if(key==="multiplier"){
      superMult=Number(value);
      document.getElementById("superMultDisplay").textContent="SUPER Multiplier: x"+superMult.toFixed(1);
      addLog("Cheat: set SUPER Multiplier to x"+superMult.toFixed(1)+".",isDev?"dev":"cheat");
    }
    if(key==="prestiges"){
      prestiges=Number(value);if(prestiges<0)prestiges=0;
      prestigeCost=50000+50000*prestiges;
      recalcCostCap();
      document.getElementById("prestigeCount").textContent="Prestiges: "+prestiges;
      document.getElementById("prestigeCost").textContent="Prestige cost: "+prestigeCost.toLocaleString();
      updatePTMDisplay();
      addLog("Cheat: set prestiges to "+prestiges+".",isDev?"dev":"cheat");
    }
    if(key==="playtime_multi"){
      ptmOverride=Number(value);
      if(isNaN(ptmOverride)||ptmOverride<=0)ptmOverride=null;
      updatePTMDisplay();
      addLog("Cheat: set PTM override to "+(ptmOverride?("x"+ptmOverride.toFixed(2)):"none")+".",isDev?"dev":"cheat");
    }
    if(key==="cosmic_coins"){
      cosmicCoins=Number(value);if(cosmicCoins<0)cosmicCoins=0;
      updateCosmicRebirthUI();
      addLog("Cheat: set Cosmic Coins to "+cosmicCoins+".",isDev?"dev":"cheat");
    }
    if(key==="rebirth_points"){
      rebirthPoints=Number(value);if(rebirthPoints<0)rebirthPoints=0;
      updateCosmicRebirthUI();
      addLog("Cheat: set Rebirth Points to "+rebirthPoints+".",isDev?"dev":"cheat");
    }
  }

  checkAchievements(0,false,false);
}

