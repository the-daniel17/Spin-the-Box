<hr>
<h2>Achievements</h2>
<div id="achievementList"></div>

<h3>Cheat Console</h3>
<input id="cheatInput" placeholder="Type cheat code...">
<button onclick="cheat(document.getElementById('cheatInput').value)">Run</button>
<p id="cheatWarning"></p>
<button id="cheaterToggle" onclick="enableCheaterMode()">⚠ Enable Cheater Mode (Permanent)</button>

<div id="cheatPanel">
  <h4>Cheat Commands</h4>
