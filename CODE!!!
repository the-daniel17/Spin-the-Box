</div>

<div id="prestigeModal" class="modal-backdrop">
  <div class="modal">
    <h3>Prestige Confirmation</h3>
    <p>You will reset your upgrades,<br>but gain a permanent +75% spin bonus per prestige.</p>
    <p id="prestigeSummary"></p>
    <button onclick="confirmPrestigeYes()">Yes, Prestige</button>
    <button onclick="confirmPrestigeNo()">Cancel</button>
  </div>
</div>

