  <div class="modal">
    <p>Why not take a breather?<br><br>Do you need some time outside?</p>
    <button onclick="closeBreather()">Yeah...</button>
    <button onclick="closeBreather()">I'm fine.</button>
  </div>
</div>

<script>
/* ---------- CORE STATE ---------- */
let spinCount=0,lifetimeSpins=0,prestigeSpins=0,rebirthSpins=0;
let canSpin=true;
let baseCooldown=3.0;
let upgradeCost=5;
let spinGain=0,spinBuyCost=5;
let superSpinChance=20,superSpinUpgradeCost=5;
let superMult=3,superMultLevel=0,superMultUpgradeCost=10;
let cheatUsed=false;
let prestiges=0,prestigeCost=50000;
const BASE_COST_CAP=3500000;
let COST_CAP=BASE_COST_CAP;

let autoCooldown=10,autoUpgradeCost=1,autoTimer=null;

let playTimeSeconds=0,playTimer=null,breatherShown=false;
let manualSuperStreak=0,autoSuperStreak=0;

let cheaterMode=false,devmodeEnabled=false,devmodeEver=false;
let ptmOverride=null;
let currentLogFilter="all";

/* Rebirth layer */
let cosmicCoins=0;
let rebirths=0;
let rebirthPoints=0;
let rebirthScalingFactor=1.0;
let rebirthNodes={
  rb_spinBoost:false,
  rb_cdBoost:false,
  rb_autoBoost:false,
  rb_superBoost:false,
  rb_ptmBoost:false
};

/* ---------- ACHIEVEMENT DATA ---------- */
const achievements=[
  {id:"firstSpin",name:"The Beginning",desc:"Spin the box once.",requirement:1,category:"General",unlocked:false},
  {id:"super",name:"SUPER!",desc:"Trigger a SUPER SPIN.",requirement:"super",category:"Super",unlocked:false},
  {id:"cooldown05",name:"Speed Demon",desc:"Reach 0.5s base cooldown.",requirement:"cooldown05",category:"Upgrades",unlocked:false},
  {id:"super100",name:"Maxiuimum Luck",desc:"Reach 100% SUPER chance.",requirement:"super100",category:"Upgrades",unlocked:false},
  {id:"overcap",name:"Beyond Limits",desc:"Go beyond normal caps.",requirement:"overcap",category:"Super",unlocked:false},
  {id:"cheat",name:"Cheater",desc:"Use a cheat.",requirement:"cheat",category:"Special",unlocked:false},
  {id:"prestige1",name:"A new beginning. But buffed",desc:"Prestige once.",requirement:"prestige1",category:"Prestige",unlocked:false},
  {id:"prestige3",name:"Aain and again and again and again",desc:"Prestige 3 times.",requirement:"prestige3",category:"Prestige",unlocked:false},
  {id:"prestige5",name:"This is getting old,and expensive!",desc:"Prestige 5 times.",requirement:"prestige5",category:"Prestige",unlocked:false},
  {id:"prestige10",name:"It costs A LOT to prestige now eh?",desc:"Prestige 10 times.",requirement:"prestige10",category:"Prestige",unlocked:false},
  {id:"autoSuper",name:"DAYUM! THATS GOOD!",desc:"Get a SUPER AUTO-SPIN.",requirement:"autoSuper",category:"Super",unlocked:false},
  {id:"breather30",name:"Take a Breather",desc:"Play for 30 minutes.",requirement:"breather30",category:"Time",unlocked:false},
  {id:"superStreak",name:"SUPER Streak",desc:"5 manual SUPERs in a row.",requirement:"superStreak",category:"Super",unlocked:false},
  {id:"autoMadness",name:"Super-AUTO Streak",desc:"5 auto SUPERs in a row.",requirement:"autoMadness",category:"Super",unlocked:false},
  {id:"chatgptChaos",name:"What ChatGPT does",desc:"Get over 10m spins or somehow get less than 0 spins.",requirement:"chatgptChaos",category:"Special",unlocked:false},
  {id:"resurrector",name:"Code Resurrector",desc:"Play 1 hour without cheat penalty.",requirement:"resurrector",category:"Time",unlocked:false},
  {id:"devmode",name:"So you must know the guy who made this",desc:"Enable devmode.",requirement:"devmode",category:"Special",unlocked:false},
  {id:"completionist",name:"Completionist",desc:"Unlock almost everything legit.",requirement:"completionist",category:"Special",unlocked:false},
  {id:"rebirth1",name:"Cosmic Reality",desc:"Rebirth once.",requirement:"rebirth1",category:"Rebirth",unlocked:false},
  {id:"rebirth3",name:"INSANE DEDACATION",desc:"Rebirth 3 times.",requirement:"rebirth3",category:"Rebirth",unlocked:false},
  {id:"rebirth5",name:"Very interesing...",desc:"Rebirth 5 times.",requirement:"rebirth5",category:"Rebirth",unlocked:false},
  {id:"rebirth10",name:"You ARE the box",desc:"Rebirth 10 times.",requirement:"rebirth10",category:"Rebirth",unlocked:false},
  {id:"myEyes", name:"MY EYES!", desc:"Switch to Light Mode.", requirement:"myEyes", category:"Fun", unlocked:false},
  {id:"phew", name:"PHEW!", desc:"Switch back to Dark Mode.", requirement:"phew", category:"Fun", unlocked:false},
  {id:"cosmic100",name:"Daniel's Blessing of 100% Cosmicity",desc:"Get 100 Cosmic Coins.",requirement:"cosmic100",category:"Rebirth",unlocked:false},
  {id:"cheaterPath",name:"Cheater's Path",desc:"Enable Cheater Mode.",requirement:"cheaterPath",category:"Special",unlocked:false},
  {id:"idiot",name:"You Idiot",desc:"Push cooldown or SUPER beyond sense.",requirement:"idiot",category:"Special",unlocked:false}
];

/* ---------- ACHIEVEMENT UI ---------- */
function updateAchievementList(){
  const container=document.getElementById("achievementList");
  container.innerHTML="";
  let byCat={};
  achievements.forEach(a=>{
    if(!byCat[a.category])byCat[a.category]=[];
    byCat[a.category].push(a);
  });
  Object.keys(byCat).forEach(cat=>{
    const h=document.createElement("h3");
    h.textContent=cat;
    container.appendChild(h);
    byCat[cat].forEach(a=>{
      const p=document.createElement("p");
      p.className=a.unlocked?"unlocked":"locked";
      p.textContent=(a.unlocked?"[✓] ":"[X] ")+a.name+" — "+a.desc;
      container.appendChild(p);
    });
  });
}
function unlockAchievement(a){
  if(a.unlocked) return;
  a.unlocked = true;

  //Achievement popup (ALWAYS shows)
  alert("You got an achievement! It's called:\n" + a.name);

  updateAchievementList();
  addLog("Achievement unlocked: " + a.name, "achievement");
}


/* ---------- LOGGING ---------- */
function addLog(text,type="info"){
  const logEntries=document.getElementById("logEntries");
  const entry=document.createElement("div");
  entry.className="log-entry log-"+type;
  const timeSpan=document.createElement("span");
  timeSpan.className="time";
  const now=new Date();
  timeSpan.textContent="["+now.toLocaleTimeString()+"]";
  const textSpan=document.createElement("span");
  textSpan.className="text";
  textSpan.textContent=" "+text;
  entry.appendChild(timeSpan);
  entry.appendChild(textSpan);
  logEntries.appendChild(entry);
  applyLogFilter();
  logEntries.scrollTop=logEntries.scrollHeight;
}
function setLogFilter(filter){
  currentLogFilter=filter;
  document.querySelectorAll(".log-filters button").forEach(btn=>btn.classList.remove("active"));
  const btn=document.getElementById("filter-"+filter);
  if(btn)btn.classList.add("active");
  applyLogFilter();
}
function applyLogFilter(){
  const entries=document.querySelectorAll(".log-entry");
  entries.forEach(e=>{
    if(currentLogFilter==="all"){e.style.display="block";return;}
    if(e.classList.contains("log-"+currentLogFilter))e.style.display="block";
    else e.style.display="none";
  });
}
function clearLogs(){
  document.getElementById("logEntries").innerHTML="";
}

/* ---------- MATH HELPERS ---------- */
function rebirthMult(){
  // simple: +1x per rebirth
  return 1+rebirths;
}
function globalMult(){
  // +75% per prestige, multiplied by rebirth multiplier
  return (1+0.75*prestiges)*rebirthMult();
}
function currentPTM(){
  if(ptmOverride)return ptmOverride;
  // simple PTM: grows slowly with playtime, capped a bit
  let base=1+playTimeSeconds/6000; // +0.1 per 10 minutes
  if(rebirthNodes.rb_ptmBoost)base*=1.1;
  return base;
}
function effectiveCooldown(){
  let cd=baseCooldown;
  if(rebirthNodes.rb_cdBoost)cd*=0.9;
  if(cd<0.1)cd=0.1;
  return cd;
}
function recalcCostCap(){
  // scale cap slightly with rebirths
  COST_CAP=Math.floor(BASE_COST_CAP*rebirthMult());
}

/* ---------- UI UPDATE HELPERS ---------- */
function updateCooldownDisplay(){
  document.getElementById("cooldownDisplay").textContent=
    "Current cooldown: "+effectiveCooldown().toFixed(1)+"s";
}
function updateSpinGainDisplay(){
  document.getElementById("spinGainDisplay").textContent=
    "Spin Gain: +"+(1+spinGain)+" per spin (before multipliers)";
}
function updatePTMDisplay(){
  const ptm=currentPTM()*globalMult();
  document.getElementById("ptmDisplay").textContent=
    "Playtime Multiplier: x"+ptm.toFixed(2);
}
function updateCosmicRebirthUI(){
  document.getElementById("cosmicCoinsDisplay").textContent="Cosmic Coins: "+cosmicCoins;
  document.getElementById("rebirthsDisplay").textContent="Rebirths: "+rebirths;
  document.getElementById("rebirthPointsDisplay").textContent="Rebirth Points: "+rebirthPoints;
  document.getElementById("rebirthMultDisplay").textContent="Rebirth Multiplier: x"+rebirthMult().toFixed(0);
  document.getElementById("rebirthCostDisplay").textContent="Next Rebirth Cost: "+rebirthCost()+" Cosmic Coins";
}

/* ---------- CONFETTI ---------- */
function spawnConfetti(x,y){
  for(let i=0;i<12;i++){
    const c=document.createElement("div");
    c.className="confetti";
    c.style.left=(x+Math.random()*80-40)+"px";
    c.style.top=(y+Math.random()*40-20)+"px";
    c.style.backgroundColor=["#ff0","#001affff","#f0f","#0ff","rgba(255, 0, 0, 1)","#f80","rgba(0, 255, 0, 1)"][Math.floor(Math.random()*5)];
    c.style.animationDuration=(0.6+Math.random()*0.4)+"s";
    document.body.appendChild(c);
    setTimeout(()=>c.remove(),1000);
  }
}

function switchTheme(){
  const body = document.body;
  const wasDark = body.classList.contains("dark");

  body.classList.toggle("dark");

  // NEW ACHIEVEMENT TRIGGERS
  if (wasDark && !body.classList.contains("dark")) {
    // Dark → Light
    let a = achievements.find(x => x.id === "myEyes");
    if (a && !a.unlocked) unlockAchievement(a);

    // FLASHBANG EFFECT
    body.classList.add("flashbang");
    setTimeout(() => body.classList.remove("flashbang"), 600);
  }

  if (!wasDark && body.classList.contains("dark")) {
    // Light → Dark
    let a = achievements.find(x => x.id === "phew");
    if (a && !a.unlocked) unlockAchievement(a);
  }
}


/* ---------- ACHIEVEMENT CHECKS ---------- */
function checkAchievements(gained,wasSuper,wasAutoSuper){
  achievements.forEach(a=>{
    if(a.unlocked)return;
    if(typeof a.requirement==="number" && lifetimeSpins>=a.requirement)unlockAchievement(a);
    if(a.requirement==="super" && wasSuper)unlockAchievement(a);
    if(a.requirement==="cooldown05" && baseCooldown<=0.5)unlockAchievement(a);
    if(a.requirement==="super100" && superSpinChance>=100)unlockAchievement(a);
    if(a.requirement==="overcap" && (superSpinChance>100||baseCooldown<0.5))unlockAchievement(a);
    if(a.requirement==="cheat" && cheatUsed)unlockAchievement(a);
    if(a.requirement==="prestige1" && prestiges>=1)unlockAchievement(a);
    if(a.requirement==="prestige3" && prestiges>=3)unlockAchievement(a);
    if(a.requirement==="prestige5" && prestiges>=5)unlockAchievement(a);
    if(a.requirement==="prestige10" && prestiges>=10)unlockAchievement(a);
    if(a.requirement==="autoSuper" && wasAutoSuper)unlockAchievement(a);
    if(a.requirement==="breather30" && playTimeSeconds>=1800)unlockAchievement(a);
    if(a.requirement==="superStreak" && manualSuperStreak>=5)unlockAchievement(a);
    if(a.requirement==="autoMadness" && autoSuperStreak>=5)unlockAchievement(a);
    if(a.requirement==="chatgptChaos" && (lifetimeSpins>10000000||spinCount<0))unlockAchievement(a);
    if(a.requirement==="resurrector" && playTimeSeconds>=3600 && (!cheatUsed||devmodeEnabled))unlockAchievement(a);
    if(a.requirement==="devmode" && devmodeEver)unlockAchievement(a);
    if(a.requirement==="completionist"){
      let nonSpecial=achievements.filter(x=>x.id!=="completionist" && x.category!=="Special");
      if(nonSpecial.every(x=>x.unlocked) && (!cheatUsed||devmodeEnabled))unlockAchievement(a);
    }
    if(a.requirement==="rebirth1" && rebirths>=1)unlockAchievement(a);
    if(a.requirement==="rebirth3" && rebirths>=3)unlockAchievement(a);
    if(a.requirement==="rebirth5" && rebirths>=5)unlockAchievement(a);
    if(a.requirement==="rebirth10" && rebirths>=10)unlockAchievement(a);
    if(a.requirement==="cosmic100" && cosmicCoins>=100)unlockAchievement(a);
    if(a.requirement==="cheaterPath" && cheaterMode)unlockAchievement(a);
    if(a.requirement==="knowDev" && devmodeEver)unlockAchievement(a);
    if(a.requirement==="idiot" && (superSpinChance>100||baseCooldown<0.5))unlockAchievement(a);
  });
  if(!breatherShown && playTimeSeconds>=1800){
    breatherShown=true;
    document.getElementById("breatherModal").style.display="flex";
    addLog("Breather suggestion shown (30 minutes).","system");
  }
}

/* ---------- SPIN LOGIC ---------- */
function spinBox(){
  if(!canSpin)return;
  const box=document.getElementById("box");
  const msg=document.getElementById("message");
  const btn=document.getElementById("spinButton");
  canSpin=false;
  box.classList.add("spin-active");
  setTimeout(()=>box.classList.remove("spin-active"),200);
  const r=box.getBoundingClientRect();
  spawnConfetti(r.left+r.width/2,r.top+r.height/2);

  let base=(1+spinGain);
  let ptm=currentPTM()*globalMult();
  let gained=Math.floor(base*ptm);
  if(rebirthNodes.rb_spinBoost)gained=Math.floor(gained*1.25);

  let roll=Math.random()*100;
  let wasSuper=false;

  if(roll<superSpinChance){
    let superGain=Math.floor(gained*superMult);
    gained=superGain;
    wasSuper=true;
    if(superSpinChance>=20 && superSpinChance<=75)manualSuperStreak++;else manualSuperStreak=0;
    msg.innerHTML="SUPER SPIN!!! (+"+gained+") x"+superMult.toFixed(1);
    addLog("SUPER SPIN for +"+gained+" (x"+superMult.toFixed(1)+")","info");
  }else{
    manualSuperStreak=0;
    msg.innerHTML="You spinned the box! (+"+gained+")";
  }

  spinCount+=gained;
  lifetimeSpins+=gained;
  prestigeSpins+=gained;
  rebirthSpins+=gained;

  document.getElementById("counter").textContent="Times box spun: "+spinCount;
  document.getElementById("lifetime").textContent="Lifetime box spun: "+lifetimeSpins;
  document.getElementById("prestigeSpinDisplay").textContent="Spins this prestige: "+prestigeSpins;
  document.getElementById("rebirthSpinDisplay").textContent="This Rebirth Spins: "+rebirthSpins;

  msg.classList.add("show");
  let cd=effectiveCooldown();
  setTimeout(()=>msg.classList.remove("show"),cd*1000);

  let timeLeft=cd;
  btn.textContent="Cooldown: "+timeLeft.toFixed(1);
  const countdown=setInterval(()=>{
    timeLeft-=0.1;
    btn.textContent="Cooldown: "+Math.max(0,timeLeft).toFixed(1);
    if(timeLeft<=0){
      clearInterval(countdown);
      btn.textContent="Spin the Box";
      canSpin=true;
    }
  },100);

  checkAchievements(gained,wasSuper,false);
}

