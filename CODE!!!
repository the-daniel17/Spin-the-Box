/* ---------- UPGRADES ---------- */
function upgradeAuto(){
  if(spinCount<autoUpgradeCost)return alert("Not enough spins!");
  spinCount-=autoUpgradeCost;
  autoCooldown-=0.2;
  if(autoCooldown<0.5)autoCooldown=0.5;
  autoUpgradeCost=Math.ceil(autoUpgradeCost*(1.1*rebirthScalingFactor));
  if(autoUpgradeCost>COST_CAP)autoUpgradeCost=COST_CAP;
  document.getElementById("autoInfo").textContent=
    "Auto-click: "+autoCooldown.toFixed(1)+"s | Cost: "+autoUpgradeCost+" spin"+(autoUpgradeCost===1?"":"s");
  document.getElementById("counter").textContent="Times box spun: "+spinCount;
  addLog("Upgraded auto-click to "+autoCooldown.toFixed(1)+"s.","system");
  startAutoClicker();
}
function upgradeCooldown(){
  if(spinCount<upgradeCost)return alert("Not enough spins!");
  spinCount-=upgradeCost;
  baseCooldown-=0.1;
  if(baseCooldown<0.5){
    baseCooldown=0.5;
    let idiot=achievements.find(a=>a.id==="idiot");
    if(idiot && !idiot.unlocked)unlockAchievement(idiot);
  }
  upgradeCost=Math.ceil(upgradeCost*(1.25*rebirthScalingFactor));
  if(upgradeCost>COST_CAP)upgradeCost=COST_CAP;
  document.getElementById("upgradeCost").textContent="Upgrade cost: "+upgradeCost+" spins";
  document.getElementById("counter").textContent="Times box spun: "+spinCount;
  updateCooldownDisplay();
  addLog("Upgraded base cooldown to "+baseCooldown.toFixed(1)+"s (effective "+effectiveCooldown().toFixed(1)+"s).","system");
  checkAchievements(0,false,false);
}
function buySpins(){
  if(spinCount<spinBuyCost)return alert("Not enough spins!");
  spinCount-=spinBuyCost;
  spinGain++;
  spinBuyCost=Math.ceil(spinBuyCost*(1.5*rebirthScalingFactor));
  if(spinBuyCost>COST_CAP)spinBuyCost=COST_CAP;
  document.getElementById("spinBuyCost").textContent="Spin gain upgrade cost: "+spinBuyCost+" spins";
  document.getElementById("counter").textContent="Times box spun: "+spinCount;
  updateSpinGainDisplay();
  addLog("Increased spin gain to +"+(1+spinGain)+" per spin (before multipliers).","system");
}
function upgradeSuperSpin(){
