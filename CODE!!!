<div id="logPanel">
  <h4>Logs</h4>
  <div class="log-filters">
    <button onclick="setLogFilter('all')" id="filter-all" class="active">All</button>
    <button onclick="setLogFilter('info')" id="filter-info">Info</button>
    <button onclick="setLogFilter('system')" id="filter-system">System</button>
    <button onclick="setLogFilter('cheat')" id="filter-cheat">Cheat</button>
    <button onclick="setLogFilter('dev')" id="filter-dev">Dev</button>
    <button onclick="setLogFilter('achievement')" id="filter-achievement">Achv</button>
