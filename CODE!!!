<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Spin the Box</title>
<style>
.glow-subtitle {
  font-weight: bold;
  color: #8dd639ff;
  text-shadow:
    0 0 5px #334bffff,
    0 0 10px #aa33ffff,
    0 0 15px #4000ffff,
    0 0 20px #00bbffff,
    0 0 30px #4b00ccff;
  animation: glowPulse 2s ease-in-out infinite;
}

@keyframes glowPulse {
  0% { text-shadow: 0 0 5px #4733ffff, 0 0 10px rgba(51, 122, 255, 1), 0 0 15px #ff00ff; }
  50% { text-shadow: 0 0 10px #ff8c66ff, 0 0 20px #ff33a0ff, 0 0 30px #00ff66ff; }
  100% { text-shadow: 0 0 5px #ffe433ff, 0 0 10px #7a33ffff, 0 0 15px #00ffe1ff; }
}

@keyframes eyeDestroyer {
  0% { filter: brightness(1); }
  20% { filter: brightness(4); }
  40% { filter: brightness(6); }
  60% { filter: brightness(4); }
  80% { filter: brightness(2); }
  100% { filter: brightness(1); }
}

.flashbang {
  animation: eyeDestroyer 0.6s ease-out;
}

:root {
  --bg:#fff;--text:#222;--accent:#44f;--accent-soft:#dde3ff;--border:#ccc;
  --log-bg:#f7f7f7;--log-border:#ccc;--log-info:#064;--log-system:#aa6a00;
  --log-cheat:#088;--log-dev:#408;--log-error:#b00020;--log-achievement:#7b1fa2;
}
body.dark {
  --bg:#12001f;--text:#f8eaff;--accent:#ff77ff;--accent-soft:#2a003f;--border:#5a2a7a;
  --log-bg:#1a0028;--log-border:#7b3fa8;--log-info:#7cffc4;--log-system:#ffd27f;
  --log-cheat:#7cfbff;--log-dev:#c77bff;--log-error:#ff6b9c;--log-achievement:#ff9bff;
}
body,button,h1,p{font-family:"Courier New",monospace;letter-spacing:1px;background:var(--bg);color:var(--text);}
h1{margin-bottom:4px;}
#box{
  width:150px;height:150px;border-radius:10px;margin-bottom:8px;
  background:linear-gradient(45deg,red,orange,yellow,lime,green,cyan,skyblue,blue,indigo,purple,magenta,pink,red);
  background-size:600% 600%;animation:rainbowShift 6s linear infinite;
  transition:transform .2s ease,filter .2s ease;
}
@keyframes rainbowShift{0%{background-position:0 50%}50%{background-position:100% 50%}100%{background-position:0 50%}}
.spin-active{transform:scale(1.2) rotate(360deg);filter:brightness(1.4);}
#message{margin-top:10px;font-size:18px;opacity:0;transition:opacity .3s ease;}
#message.show{opacity:1;}
button{
  margin-top:4px;padding:4px 8px;border-radius:6px;border:1px solid var(--border);
  background:var(--accent-soft);color:var(--text);cursor:pointer;
}
button:hover{filter:brightness(1.05);}
#themeToggle{margin-left:6px;}
.modal-backdrop{
  position:fixed;inset:0;background:rgba(0,0,0,.4);display:none;
  align-items:center;justify-content:center;z-index:999;
}
.modal{
  background:var(--bg);padding:16px 24px;border-radius:10px;
  box-shadow:0 0 15px rgba(0,0,0,.4);max-width:360px;text-align:center;
  border:1px solid var(--accent);
}
#achievementList h3{margin:12px 0 4px;text-decoration:underline;}
#achievementList p.unlocked{color:#080;}
#achievementList p.locked{color:#b00020;}
#cheatPanel{
  margin-top:8px;padding:8px;border-radius:8px;border:1px dashed var(--accent);
  background:var(--accent-soft);display:none;max-width:420px;
}
#cheatPanel h4{margin:4px 0;}
#cheatPanel code{background:#eee;padding:1px 4px;border-radius:4px;}
body.dark #cheatPanel code{background:#2a003f;color:#f8eaff;}
#cheatWarning{color:#b00020;font-size:12px;margin-top:4px;}
#cheaterToggle{border:1px solid #b71c1c;background:#ffe5e5;}
body.dark #cheaterToggle{background:#3a0010;color:#ffd0d0;}
#logPanel{
  margin-top:10px;padding:8px;border-radius:8px;border:1px solid var(--log-border);
  background:var(--log-bg);max-width:420px;max-height:180px;overflow-y:auto;font-size:11px;
}
#logPanel h4{margin:0 0 4px;}
.log-entry{margin:2px 0;font-family:"Courier New",monospace;}
.log-entry .time{color:#777;margin-right:4px;}
.log-info .text{color:var(--log-info);}
.log-system .text{color:var(--log-system);}
.log-cheat .text{color:var(--log-cheat);}
.log-dev .text{color:var(--log-dev);}
.log-error .text{color:var(--log-error);}
.log-achievement .text{color:var(--log-achievement);}
.log-filters button{
  margin:2px;padding:2px 6px;font-size:10px;border-radius:6px;
  border:1px solid var(--border);background:var(--bg);
}
.log-filters button.active{background:var(--accent-soft);}
#clearLogsBtn{margin-top:4px;padding:2px 6px;font-size:10px;}
.confetti{
  position:absolute;width:6px;height:10px;background:#ff0;opacity:.9;
  pointer-events:none;animation:confettiFall .8s linear forwards;z-index:500;
}
@keyframes confettiFall{
  0%{transform:translateY(0) rotate(0);opacity:1;}
  100%{transform:translateY(80px) rotate(360deg);opacity:0;}
}
#rebirthPanel{
  margin-top:10px;padding:8px;border-radius:8px;border:1px solid var(--accent);
  background:var(--accent-soft);max-width:420px;
}
#rebirthTree{
  margin-top:6px;padding:6px;border-radius:6px;border:1px dashed var(--border);
  background:var(--bg);font-size:12px;
}

/* === Glow Buttons for V2.9.1 === */
.glow-button {
  color: #eae0e0ff;
  background: #5a4545ff;
  border: 2px solid #66ffcc;
  padding: 6px 12px;
  border-radius: 6px;
  text-shadow: 0 0 10px #66faffff;
  box-shadow: 0 0 15px #ffe066ff;
  animation: glowBtn 2s infinite ease-in-out;
  cursor: pointer;
}
@keyframes glowBtn {
  50% { box-shadow: 0 0 25px #00ffee; }
}
</style>
</head>

<!-- dark mode ON by default -->
<body class="dark">
<h1 class="glow-subtitle"> Spin the Box [ALPHA V3.0.0 - The great reboot]</h1>
